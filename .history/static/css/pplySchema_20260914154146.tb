import 'dotenv/config';
import { readFile } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import path from 'node:path';
import { Pool } from 'pg';
import { getDatabaseConnectionString } from '../config';

async function run(): Promise<void> {
  const schemaPath = path.resolve(process.cwd(), 'database', 'postgres_schema.sql');

  if (!existsSync(schemaPath)) {
    throw new Error(`فایلی سکێما لەم شوێنە نەدۆزرایەوە: ${schemaPath}`);
  }

  const sql = await readFile(schemaPath, 'utf8');
  const pool = new Pool({ connectionString: getDatabaseConnectionString() });
  const client = await pool.connect();

  try {
    await client.query(sql);
    console.log('✓ سکێمای بنکەدراوە بەسەرکەوتوویی جێبەجێکرا.');
  } finally {
    client.release();
    await pool.end();
  }
}

run().catch((error) => {
  console.error('✕ جێبەجێکردنی سکێما شکستی هێنا:', error);
  process.exit(1);
});